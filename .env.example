# OpsPilot Environment Configuration Example
# Copy this file to .env or set environment variables in your deployment

# Jev AI Configuration
JEV_API_URL=https://thejevai.com/v1/systemone
JEV_API_KEY=your_jev_api_key_here

# JWT Security
JWT_SECRET=your_jwt_secret_key_at_least_32_bytes_long

# Server Port
PORT=8080
VITE_API_URL=http://localhost:8080/api
